# Copy this file to config/.env and replace the placeholder values.
Secret_key=replace-with-a-generated-secret-key
# DATABASE_URL is the database NAME in this project, not a connection URL.
DATABASE_URL=blog
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-your-local-postgresql-password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_SCHEMA=blog_schema
api_key=replace-with-your-key
OPENAI_APIKEY=